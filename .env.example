# Vault Global Configuration
VAULT_ENV=development
VAULT_LOG_LEVEL=INFO
VAULT_SECRET_KEY=replace-with-a-long-random-secret-before-running-compose

# Cluster Configuration Path
VAULT_CLUSTER_CONFIG_PATH=config/cluster.yaml
VAULT_POLICIES_CONFIG_PATH=config/policies.yaml

# Storage Node Defaults
VAULT_DATA_DIR=/data
VAULT_NODE_PORT=8001
VAULT_METRICS_ENABLED=true

# Gateway Defaults
VAULT_GATEWAY_PORT=8000
VAULT_CHUNK_SIZE_BYTES=8388608 # 8 MiB default chunk size
