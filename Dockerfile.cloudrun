FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY apps ./apps
COPY vault_core ./vault_core
RUN pip install --no-cache-dir . && useradd --create-home --uid 10001 vault
USER vault
ENV PYTHONPATH=/app PORT=8080 VAULT_MODE=cloud_demo
EXPOSE 8080
CMD exec uvicorn apps.cloud_demo.main:app --host 0.0.0.0 --port "${PORT}"
